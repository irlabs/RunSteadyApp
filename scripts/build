#!/usr/bin/env bash
# Builds the phone app (with the watch app embedded) for real devices.
# Version comes from ./VERSION; the build number is a timestamp (yymmdd.HHMM), so every
# build is distinguishable and the phone can tell whether the watch runs the same one.
set -euo pipefail
. "$(dirname "$0")/_env.sh"

VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
BUILD="$(date +%y%m%d.%H%M)"
echo "▸ Building Run Steady v$VERSION ($BUILD)"

xcodebuild build -quiet \
  -project "$ROOT/RunSteady.xcodeproj" -scheme RunSteady -configuration Debug \
  -destination 'generic/platform=iOS' -derivedDataPath "$DERIVED" -allowProvisioningUpdates \
  MARKETING_VERSION="$VERSION" CURRENT_PROJECT_VERSION="$BUILD"

echo "✓ Phone app $(version_of "$PHONE_APP") ($(build_of "$PHONE_APP")) · watch app $(version_of "$WATCH_APP") ($(build_of "$WATCH_APP"))"
